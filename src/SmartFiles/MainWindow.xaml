<Window x:Class="SmartFiles.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#233F35" Title="SmartFiles" Icon="Assets/SmartFiles.ico" Width="1280" Height="850" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="ClosingWindow">
<Grid Background="#F7F9F8"><Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#F0F4F2" BorderBrush="#E0E7E3" BorderThickness="0,0,1,0"><DockPanel Margin="18,30,18,24"><StackPanel DockPanel.Dock="Top" Margin="10,0,0,34"><TextBlock Text="SmartFiles" FontSize="25" FontWeight="Bold" Foreground="#1C5549"/><TextBlock Text="让文件各归其位" Foreground="#83958C" Margin="2,7,0,0"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="10,0,0,0"><TextBlock Text="安心整理" Foreground="#4D7566" FontWeight="SemiBold"/><TextBlock Text="旧文件不动 · 整理前确认" FontSize="11" Foreground="#83958C" Margin="0,7,0,0"/></StackPanel><StackPanel><RadioButton x:Name="Nav0" GroupName="Navigation" IsChecked="True" Tag="0" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="待整理"/></StackPanel></RadioButton><RadioButton x:Name="Nav1" GroupName="Navigation" Tag="1" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="分类管理"/></StackPanel></RadioButton><RadioButton x:Name="Nav2" GroupName="Navigation" Tag="2" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="文件来源"/></StackPanel></RadioButton><RadioButton x:Name="Nav3" GroupName="Navigation" Tag="3" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="AI 与设置"/></StackPanel></RadioButton><RadioButton x:Name="Nav4" GroupName="Navigation" Tag="4" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="学习规则"/></StackPanel></RadioButton><RadioButton x:Name="Nav5" GroupName="Navigation" Tag="5" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="整理记录"/></StackPanel></RadioButton></StackPanel></DockPanel></Border>
<DockPanel Grid.Column="1" Margin="30,26,30,20"><Grid DockPanel.Dock="Top" Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="待整理" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="检查推荐，确认后轻松归档。" Foreground="#83918A" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="MonitorButton" Style="{StaticResource PrimaryButton}" Content="启用监控" Click="ToggleMonitor"/><Button Content="关闭界面" Click="HideWindow"/></StackPanel></Grid>
<Border DockPanel.Dock="Bottom" Padding="0,14,0,0"><TextBlock x:Name="Status" Text="正在初始化…" FontSize="12" Foreground="#70847A" TextWrapping="Wrap"/></Border>
 <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
 <TabItem Header="首页 / 待确认"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,15"><TextBlock x:Name="Summary" FontSize="22" FontWeight="SemiBold" Foreground="#173D36"/><TextBlock Text="仅管理启用后新进入来源的文件。选择文件检查推荐；关闭界面后，轻量监听器继续等待新文件。" Foreground="#71817A" Margin="0,6,0,0"/></StackPanel>
 <DataGrid x:Name="QueueGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="SelectionChanged" KeyDown="QueueKeyDown"><DataGrid.Columns>
 <DataGridTextColumn Header="新文件" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="来源" Binding="{Binding SourceName}" Width="*"/>
 <DataGridTextColumn Header="推荐分类" Binding="{Binding TargetLabel}" Width="2*"/><DataGridTextColumn Header="判断方式" Binding="{Binding Method}" Width="95"/>
 <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceDisplay}" Width="110"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="75"/>
 </DataGrid.Columns></DataGrid>
 <Border x:Name="EmptyQueue" Grid.Row="1" Background="White" CornerRadius="12" IsHitTestVisible="False"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Background="#E9F5F1" CornerRadius="24" Width="64" Height="64" Margin="0,0,0,20"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#247C6C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="一切就绪，等待新文件" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="启用来源监控后，新收到的文件会出现在这里。" Foreground="#7A8987" Margin="0,10,0,0"/></StackPanel></Border>
 <Border Grid.Row="2" Background="White" BorderBrush="#E2E8E7" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,16,0,0"><StackPanel>
 <TextBlock x:Name="Details" Text="选择文件以检查推荐。" TextWrapping="Wrap" Margin="0,0,0,8"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <ComboBox x:Name="FolderChoice" DisplayMemberPath="Label" SelectedValuePath="Id" Margin="0,4,12,8" Padding="8" IsTextSearchEnabled="True"/>
 <TextBox x:Name="RenameBox" Grid.Column="1" ToolTip="最终文件名；仅应用于单文件确认"/>
 </Grid><CheckBox x:Name="BranchConsent" Visibility="Collapsed"/>
 <WrapPanel><Button Content="确认整理选中项" Background="#14685F" Foreground="White" Click="ConfirmSelected"/><Button Content="暂不整理 · Esc" Click="DismissSelected"/><Button Content="刷新" Click="RefreshClick"/></WrapPanel>
 </StackPanel></Border></Grid></TabItem>
 <TabItem Header="分类树"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DataGrid x:Name="TaxonomyGrid" IsReadOnly="True" SelectionChanged="CategorySelected"><DataGrid.Columns><DataGridTextColumn Header="分类路径" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="关键词" Binding="{Binding Keywords}" Width="*"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="1"><TextBlock Text="可直接在资源管理器中新建分类；目录变化会自动同步。改名会改变该目录的完整路径。" Margin="0,12,0,8"/><WrapPanel><TextBox x:Name="CategoryName" Width="220" ToolTip="新建或改名"/><Button Content="新建子分类" Click="AddCategory"/><Button Content="改名" Click="RenameCategory"/><Button Content="删除空分类" Click="DeleteCategory"/></WrapPanel><WrapPanel><TextBox x:Name="CategoryDescription" Width="300" ToolTip="分类说明"/><TextBox x:Name="CategoryKeywords" Width="300" ToolTip="关键词"/><Button Content="保存说明/关键词" Click="DescribeCategory"/></WrapPanel></StackPanel>
 </Grid></TabItem>
 <TabItem Header="来源"><Grid Margin="0" AllowDrop="True" DragOver="SourceDragOver" Drop="SourceDrop"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="勾选管理范围后启用。勾选子目录可监控接收叶目录下的月份目录；不监控聊天缓存。微信 / QQ 默认移动前提醒。" TextWrapping="Wrap" Margin="0,0,0,15"/>
 <DataGrid x:Name="SourcesGrid" Grid.Row="1"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled,UpdateSourceTrigger=PropertyChanged}" Width="55"/><DataGridCheckBoxColumn Header="子目录" Binding="{Binding Recursive}" Width="65"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="来源路径" Binding="{Binding Path}" Width="3*"/><DataGridComboBoxColumn x:Name="PolicyColumn" Header="策略" SelectedValueBinding="{Binding Policy}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="145"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="2"><TextBlock Text="旧文件保持原位；新文件也会在你确认后才移动。" Margin="0,12,0,8"/><WrapPanel><Button Content="重新自动发现" Click="Rediscover"/><Button Content="添加文件夹" Click="AddSource"/><Button Content="保存来源" Click="SaveSources"/></WrapPanel><TextBlock Text="也可以拖入文件夹。微信 msg/file 等明确接收目录支持新月份子目录，勿添加账号根目录。" Foreground="#71817A" TextWrapping="Wrap"/></StackPanel>
 </Grid></TabItem>
 <TabItem Header="AI / 设置"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="连接 AI" Style="{StaticResource SectionTitle}"/><TextBlock Text="通过 API 密钥接入。本地无法确定时，再向云端请求建议。" Style="{StaticResource Muted}" Margin="0,6,0,20"/>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="服务商"/><ComboBox x:Name="ProviderChoice" SelectionChanged="ProviderChanged" Padding="10,8" Margin="0,6,0,0"><ComboBoxItem Content="DeepSeek"/><ComboBoxItem Content="Gemini"/><ComboBoxItem Content="其他兼容接口"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="模型"/><ComboBox x:Name="TextModelBox" IsEditable="True" Padding="10,8" Margin="0,6,0,0" SelectionChanged="ModelChanged"/></StackPanel></Grid><TextBlock Text="API 密钥"/><PasswordBox x:Name="KeyBox" Padding="12,9" BorderBrush="#DCE5E2" Margin="0,6,0,5"/><TextBlock Text="密钥加密保存在本机；留空则保留已保存的密钥。" Style="{StaticResource Muted}"/>
<WrapPanel Margin="0,8,0,0"><Button Content="连接并测试" Style="{StaticResource PrimaryButton}" Click="TestApi"/><Button Content="保存设置" Click="SaveSettings"/><Button Content="获取模型列表" Click="FetchModels"/><TextBlock x:Name="ModelHint" VerticalAlignment="Center" Foreground="#7D8E85" Text="填入密钥即可连接"/></WrapPanel><Expander x:Name="ConnectionOptions" Header="更多连接选项" Margin="0,18,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="API 地址"/><TextBox x:Name="BaseUrlBox"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="文本模型"/><TextBlock Text="上方模型框支持选择或直接输入名称。" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#7D8E85"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="视觉模型（选填，需服务商支持）"/><TextBox x:Name="VisionModelBox"/></StackPanel></Grid></StackPanel></Expander>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="智能建议" Style="{StaticResource SectionTitle}"/><TextBlock Text="已默认允许 AI 使用文件名、属性、提取的文本和图片缩略图。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,2"/><Expander Header="允许发送给 AI（不提供完整文件上传）" IsExpanded="True" Margin="0,10,0,0"><WrapPanel><CheckBox x:Name="SendName" Content="文件名"/><CheckBox x:Name="SendMeta" Content="文件属性"/><CheckBox x:Name="SendText" Content="文档有限文本"/><CheckBox x:Name="SendOcr" Content="OCR 结果"/><CheckBox x:Name="SendImage" Content="图片缩略图"/></WrapPanel></Expander><Separator Margin="0,10" Background="#EEF2F0"/><WrapPanel><CheckBox x:Name="LocalAi" Content="本地语义分析"/><CheckBox x:Name="UseOcr" Content="图片文字识别"/><CheckBox x:Name="RenameAi" Content="重命名建议"/><CheckBox x:Name="ClassifyEnabled" Content="智能分类"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="日常使用" Style="{StaticResource SectionTitle}"/><WrapPanel Margin="0,10,0,0"><CheckBox x:Name="Notifications" Content="显示新文件通知"/><CheckBox x:Name="Startup" Content="开机启动轻量监听器"/><CheckBox x:Name="CloseToTray" Content="关闭窗口后驻留托盘（非默认）"/><CheckBox x:Name="StrictHash" Content="跨盘移动时完整校验"/></WrapPanel>
<WrapPanel><StackPanel Width="180"><TextBlock Text="历史最多保留（条）"/><TextBox x:Name="HistoryCountBox"/></StackPanel><StackPanel Width="180"><TextBlock Text="历史最多保留（天）"/><TextBox x:Name="HistoryDaysBox"/></StackPanel></WrapPanel><WrapPanel Margin="0,8,0,0"><StackPanel Width="190"><TextBlock Text="Worker 空闲退出（30–600秒）"/><TextBox x:Name="WorkerIdleBox"/></StackPanel><Button Content="完全退出 SmartFiles" Click="ExitAll" VerticalAlignment="Bottom"/></WrapPanel><Expander Expanded="RefreshStorage" Header="SmartFiles 自身磁盘占用" Margin="0,12,0,0"><StackPanel><DataGrid x:Name="StorageGrid" IsReadOnly="True" MaxHeight="320"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="占用" Binding="{Binding Size}" Width="140"/></DataGrid.Columns></DataGrid><WrapPanel><Button Content="刷新占用" Click="RefreshStorage"/><Button Content="清理安全缓存" Click="CleanStorage"/></WrapPanel><TextBlock Text="日志上限 50 MB，缓存及模型缓存各 100 MB；不会清理用户分类目录。" TextWrapping="Wrap" Foreground="#70847A"/></StackPanel></Expander><Expander Header="高级设置" Margin="0,14,0,0"><StackPanel Margin="0,14,0,0"><WrapPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="本地推荐阈值（0.5–1）"/><TextBox x:Name="ThresholdBox"/></StackPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="高置信度阈值（0–1）"/><TextBox x:Name="HighThresholdBox"/></StackPanel><StackPanel Width="180"><TextBlock Text="通知有效期（毫秒）"/><TextBox x:Name="TtlBox"/></StackPanel></WrapPanel><WrapPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="批次合并时间（毫秒）"/><TextBox x:Name="BatchBox"/></StackPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="每批图片 API 上限"/><TextBox x:Name="BudgetBox"/></StackPanel><StackPanel Width="180"><TextBlock Text="候选分类数（5–15）"/><TextBox x:Name="CandidateBox"/></StackPanel></WrapPanel><TextBlock Text="本地模型使用 CPU，空闲后自动退出。OCR 复用本机模型，语义与视觉采用 BGE / TinyCLIP。" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel></Border>

</StackPanel></ScrollViewer></TabItem>
 <TabItem Header="规则"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="RulesGrid"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="关键词" Binding="{Binding Keyword}" Width="*"/><DataGridComboBoxColumn x:Name="RuleFolderColumn" Header="分类" SelectedValueBinding="{Binding FolderId}" SelectedValuePath="Id" DisplayMemberPath="Label" Width="2*"/><DataGridTextColumn Header="次数" Binding="{Binding Hits}" Width="65" IsReadOnly="True"/><DataGridTextColumn Header="置信度" Binding="{Binding Confidence,StringFormat=P0}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="最近使用" Binding="{Binding LastUsed,StringFormat=yyyy-MM-dd HH:mm}" Width="*" IsReadOnly="True"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1"><Button Content="保存规则" Click="SaveRules"/><Button Content="删除选中" Click="DeleteRule"/><TextBlock Text="至少 3 次一致选择后参与推荐；一次纠正不会生成绝对规则。" VerticalAlignment="Center"/></WrapPanel></Grid></TabItem>
 <TabItem Header="历史 / 撤销"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="HistoryGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time,StringFormat=yyyy-MM-dd HH:mm}" Width="*"/><DataGridTextColumn Header="原路径" Binding="{Binding Source}" Width="2*"/><DataGridTextColumn Header="目标路径" Binding="{Binding Target}" Width="2*"/><DataGridTextColumn Header="状态" Binding="{Binding StateLabel}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1"><Button Content="撤销选中记录" Click="UndoSelected"/><Button Content="刷新记录" Click="RefreshClick"/></WrapPanel></Grid></TabItem>
 </TabControl>
</DockPanel></Grid></Window>
