<Window x:Class="SmartFiles.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI" FontSize="13" Foreground="#233F35" Title="SmartFiles" Icon="Assets/SmartFiles.ico" Width="1280" Height="850" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Closing="ClosingWindow">
<Grid Background="#F7F9F8"><Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#F0F4F2" BorderBrush="#E0E7E3" BorderThickness="0,0,1,0"><DockPanel Margin="18,30,18,24"><StackPanel DockPanel.Dock="Top" Margin="10,0,0,34"><TextBlock Text="SmartFiles" FontSize="25" FontWeight="Bold" Foreground="#1C5549"/><TextBlock Text="A place for every file" FontSize="11" TextWrapping="Wrap" Foreground="#83958C" Margin="2,7,0,0"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="10,0,0,0"><TextBlock Text="Organize safely" Foreground="#4D7566" FontWeight="SemiBold"/><TextBlock Text="Existing files stay. Confirm each move." TextWrapping="Wrap" FontSize="11" Foreground="#83958C" Margin="0,7,0,0"/></StackPanel><StackPanel><RadioButton x:Name="Nav0" GroupName="Navigation" IsChecked="True" Tag="0" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="Inbox"/></StackPanel></RadioButton><RadioButton x:Name="Nav1" GroupName="Navigation" Tag="1" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="Categories"/></StackPanel></RadioButton><RadioButton x:Name="Nav2" GroupName="Navigation" Tag="2" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="Sources"/></StackPanel></RadioButton><RadioButton x:Name="Nav3" GroupName="Navigation" Tag="3" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="AI &amp; Settings"/></StackPanel></RadioButton><RadioButton x:Name="Nav4" GroupName="Navigation" Tag="4" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="Learned Rules"/></StackPanel></RadioButton><RadioButton x:Name="Nav5" GroupName="Navigation" Tag="5" Checked="Navigate" Style="{StaticResource NavItem}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Width="32" VerticalAlignment="Center"/><TextBlock Text="History"/></StackPanel></RadioButton></StackPanel></DockPanel></Border>
<DockPanel Grid.Column="1" Margin="30,26,30,20"><Grid DockPanel.Dock="Top" Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Inbox" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Review suggestions, then confirm to organize." Foreground="#83918A" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="MonitorButton" Style="{StaticResource PrimaryButton}" Content="Enable monitoring" Click="ToggleMonitor"/><Button Content="Close window" Click="HideWindow"/></StackPanel></Grid>
<Border DockPanel.Dock="Bottom" Padding="0,14,0,0"><TextBlock x:Name="Status" Text="Initializing…" FontSize="12" Foreground="#70847A" TextWrapping="Wrap"/></Border>
 <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
 <TabItem Header="Inbox / Pending"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,15"><TextBlock x:Name="Summary" FontSize="22" FontWeight="SemiBold" Foreground="#173D36"/><TextBlock Text="Only files received after monitoring starts are included. Review suggestions here; the lightweight watcher keeps running when this window closes." Foreground="#71817A" Margin="0,6,0,0"/></StackPanel>
 <DataGrid x:Name="QueueGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="SelectionChanged" KeyDown="QueueKeyDown"><DataGrid.Columns>
 <DataGridTextColumn Header="New file" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Source" Binding="{Binding SourceDisplayName}" Width="*"/>
 <DataGridTextColumn Header="Suggested category" Binding="{Binding TargetDisplayLabel}" Width="2*"/><DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="130"/>
 <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75"/>
 </DataGrid.Columns></DataGrid>
 <Border x:Name="EmptyQueue" Grid.Row="1" Background="White" CornerRadius="12" IsHitTestVisible="False"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Background="#E9F5F1" CornerRadius="24" Width="64" Height="64" Margin="0,0,0,20"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#247C6C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Ready for new files" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Enable source monitoring to see new files here." Foreground="#7A8987" Margin="0,10,0,0"/></StackPanel></Border>
 <Border Grid.Row="2" Background="White" BorderBrush="#E2E8E7" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,16,0,0"><StackPanel>
 <TextBlock x:Name="Details" Text="Select a file to review its suggestion." TextWrapping="Wrap" Margin="0,0,0,8"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <ComboBox x:Name="FolderChoice" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id" Margin="0,4,12,8" Padding="8" IsTextSearchEnabled="True"/>
 <TextBox x:Name="RenameBox" Grid.Column="1" ToolTip="Final filename; used when confirming one file"/>
 </Grid><CheckBox x:Name="BranchConsent" Visibility="Collapsed"/>
 <WrapPanel><Button Content="Organize selected" Background="#14685F" Foreground="White" Click="ConfirmSelected"/><Button Content="Dismiss · Esc" Click="DismissSelected"/><Button Content="Refresh" Click="RefreshClick"/></WrapPanel>
 </StackPanel></Border></Grid></TabItem>
 <TabItem Header="Category tree"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DataGrid x:Name="TaxonomyGrid" IsReadOnly="True" SelectionChanged="CategorySelected"><DataGrid.Columns><DataGridTextColumn Header="Category path" Binding="{Binding DisplayLabel}" Width="2*"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Keywords" Binding="{Binding Keywords}" Width="*"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="1"><TextBlock Text="Create categories in File Explorer; folder changes sync automatically. Renaming changes the full folder path." Margin="0,12,0,8"/><WrapPanel><TextBox x:Name="CategoryName" Width="220" ToolTip="New name"/><Button Content="Add subcategory" Click="AddCategory"/><Button Content="Rename" Click="RenameCategory"/><Button Content="Delete empty category" Click="DeleteCategory"/></WrapPanel><WrapPanel><TextBox x:Name="CategoryDescription" Width="300" ToolTip="Category description"/><TextBox x:Name="CategoryKeywords" Width="300" ToolTip="Keywords"/><Button Content="Save details" Click="DescribeCategory"/></WrapPanel></StackPanel>
 </Grid></TabItem>
 <TabItem Header="Source"><Grid Margin="0" AllowDrop="True" DragOver="SourceDragOver" Drop="SourceDrop"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Text="Select sources, then enable monitoring. Include subfolders for monthly receive folders. Chat caches are excluded; WeChat and QQ require a move warning." TextWrapping="Wrap" Margin="0,0,0,15"/>
 <DataGrid x:Name="SourcesGrid" Grid.Row="1"><DataGrid.Columns><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled,UpdateSourceTrigger=PropertyChanged}" Width="55"/><DataGridCheckBoxColumn Header="Subfolders" Binding="{Binding Recursive}" Width="65"/><DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Source path" Binding="{Binding Path}" Width="3*"/><DataGridComboBoxColumn x:Name="PolicyColumn" Header="Policy" SelectedValueBinding="{Binding Policy}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="185"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="2"><TextBlock Text="Existing files stay in place. New files move only after you confirm." Margin="0,12,0,8"/><WrapPanel><Button Content="Discover sources" Click="Rediscover"/><Button Content="Add folder" Click="AddSource"/><Button Content="Save sources" Click="SaveSources"/></WrapPanel><TextBlock Text="You can also drop folders here. Use receive folders such as WeChat msg/file, including monthly subfolders; never select an account root." Foreground="#71817A" TextWrapping="Wrap"/></StackPanel>
 </Grid></TabItem>
 <TabItem Header="AI / Settings"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Connect AI" Style="{StaticResource SectionTitle}"/><TextBlock Text="Connect with an API key. Cloud suggestions are requested only when local results are uncertain." Style="{StaticResource Muted}" Margin="0,6,0,20"/>
<Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Provider"/><ComboBox x:Name="ProviderChoice" SelectionChanged="ProviderChanged" Padding="10,8" Margin="0,6,0,0"><ComboBoxItem Content="DeepSeek"/><ComboBoxItem Content="Gemini"/><ComboBoxItem Content="Other compatible API"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Model"/><ComboBox x:Name="TextModelBox" IsEditable="True" Padding="10,8" Margin="0,6,0,0" SelectionChanged="ModelChanged"/></StackPanel></Grid><TextBlock Text="API key"/><PasswordBox x:Name="KeyBox" Padding="12,9" BorderBrush="#DCE5E2" Margin="0,6,0,5"/><TextBlock Text="Your key is encrypted on this PC. Leave blank to keep the saved key." Style="{StaticResource Muted}"/>
<WrapPanel Margin="0,8,0,0"><Button Content="Test connection" Style="{StaticResource PrimaryButton}" Click="TestApi"/><Button Content="Save settings" Click="SaveSettings"/><Button Content="Load models" Click="FetchModels"/><TextBlock x:Name="ModelHint" VerticalAlignment="Center" Foreground="#7D8E85" Text="Enter a key to connect"/></WrapPanel><Expander x:Name="ConnectionOptions" Header="Connection options" Margin="0,18,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="API base URL"/><TextBox x:Name="BaseUrlBox"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Text model"/><TextBlock Text="Choose a model above or enter its name directly." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#7D8E85"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Vision model (optional; provider support required)"/><TextBox x:Name="VisionModelBox"/></StackPanel></Grid></StackPanel></Expander>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Smart suggestions" Style="{StaticResource SectionTitle}"/><TextBlock Text="AI may use filenames, metadata, limited text and compressed thumbnails by default." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,2"/><Expander Header="Allowed AI data — complete file uploads are unavailable" IsExpanded="True" Margin="0,10,0,0"><WrapPanel><CheckBox x:Name="SendName" Content="Filename"/><CheckBox x:Name="SendMeta" Content="Metadata"/><CheckBox x:Name="SendText" Content="Limited document text"/><CheckBox x:Name="SendOcr" Content="OCR text"/><CheckBox x:Name="SendImage" Content="Compressed thumbnails"/></WrapPanel></Expander><Separator Margin="0,10" Background="#EEF2F0"/><WrapPanel><CheckBox x:Name="LocalAi" Content="Local semantic analysis"/><CheckBox x:Name="UseOcr" Content="Image text recognition"/><CheckBox x:Name="RenameAi" Content="Rename suggestions"/><CheckBox x:Name="ClassifyEnabled" Content="Classification"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Everyday use" Style="{StaticResource SectionTitle}"/><WrapPanel Margin="0,10,0,0"><CheckBox x:Name="Notifications" Content="Show new-file notifications"/><CheckBox x:Name="Startup" Content="Start lightweight watcher at sign-in"/><CheckBox x:Name="CloseToTray" Content="Keep in tray after closing (off by default)"/><CheckBox x:Name="StrictHash" Content="Verify full hash for cross-drive moves"/></WrapPanel>
<WrapPanel><StackPanel Width="180"><TextBlock Text="History limit (records)"/><TextBox x:Name="HistoryCountBox"/></StackPanel><StackPanel Width="180"><TextBlock Text="History limit (days)"/><TextBox x:Name="HistoryDaysBox"/></StackPanel></WrapPanel><WrapPanel Margin="0,8,0,0"><StackPanel Width="190"><TextBlock Text="Worker idle timeout (30–600 s)"/><TextBox x:Name="WorkerIdleBox"/></StackPanel><Button Content="Exit SmartFiles completely" Click="ExitAll" VerticalAlignment="Bottom"/></WrapPanel><Expander Expanded="RefreshStorage" Header="SmartFiles disk usage" Margin="0,12,0,0"><StackPanel><DataGrid x:Name="StorageGrid" IsReadOnly="True" MaxHeight="320"><DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="140"/></DataGrid.Columns></DataGrid><WrapPanel><Button Content="Refresh usage" Click="RefreshStorage"/><Button Content="Clear safe cache" Click="CleanStorage"/></WrapPanel><TextBlock Text="Logs: 50 MB. Cache and model cache: 100 MB each. Your organized files are never cleared." TextWrapping="Wrap" Foreground="#70847A"/></StackPanel></Expander><Expander Header="Advanced settings" Margin="0,14,0,0"><StackPanel Margin="0,14,0,0"><WrapPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="Local threshold (0.5–1)"/><TextBox x:Name="ThresholdBox"/></StackPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="High confidence (0–1)"/><TextBox x:Name="HighThresholdBox"/></StackPanel><StackPanel Width="180"><TextBlock Text="Notification TTL (ms)"/><TextBox x:Name="TtlBox"/></StackPanel></WrapPanel><WrapPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="Batch window (ms)"/><TextBox x:Name="BatchBox"/></StackPanel><StackPanel Width="180" Margin="0,0,16,0"><TextBlock Text="Image API calls per batch"/><TextBox x:Name="BudgetBox"/></StackPanel><StackPanel Width="180"><TextBlock Text="Candidate count (5–15)"/><TextBox x:Name="CandidateBox"/></StackPanel></WrapPanel><TextBlock Text="Local models run on the CPU and exit when idle. OCR reuses installed models; semantic and vision analysis use BGE / TinyCLIP." Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel></Border>

</StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Rules"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="RulesGrid"><DataGrid.Columns><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="Keywords" Binding="{Binding Keyword}" Width="*"/><DataGridComboBoxColumn x:Name="RuleFolderColumn" Header="Category" SelectedValueBinding="{Binding FolderId}" SelectedValuePath="Id" DisplayMemberPath="DisplayLabel" Width="2*"/><DataGridTextColumn Header="Uses" Binding="{Binding Hits}" Width="65" IsReadOnly="True"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence,StringFormat=P0}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="Last used" Binding="{Binding LastUsed,StringFormat=yyyy-MM-dd HH:mm}" Width="*" IsReadOnly="True"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1"><Button Content="Save rules" Click="SaveRules"/><Button Content="Delete selected" Click="DeleteRule"/><TextBlock Text="A rule needs 3 consistent choices before it can suggest a category. One correction never creates an absolute rule." VerticalAlignment="Center"/></WrapPanel></Grid></TabItem>
 <TabItem Header="History / Undo"><Grid Margin="0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="HistoryGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time,StringFormat=yyyy-MM-dd HH:mm}" Width="*"/><DataGridTextColumn Header="Original path" Binding="{Binding Source}" Width="2*"/><DataGridTextColumn Header="Destination path" Binding="{Binding Target}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding StateLabel}" Width="*"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1"><Button Content="Undo selected" Click="UndoSelected"/><Button Content="Refresh history" Click="RefreshClick"/></WrapPanel></Grid></TabItem>
 </TabControl>
</DockPanel></Grid></Window>
